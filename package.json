{
  "name": "balance-keeper",
  "version": "1.0.0",
  "description": "Physics-based puzzle game",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "eas build",
    "submit": "eas submit",
    "test": "node --test --require ./tests/register.cjs tests/*.test.cjs",
    "levels:build": "node scripts/build-levels.cjs",
    "levels:validate": "node scripts/validate-levels.cjs",
    "levels:check": "node scripts/build-levels.cjs --check",
    "check": "npm test && npm run levels:validate && tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^57.0.21",
    "expo-asset": "~57.0.16",
    "expo-audio": "~57.0.4",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.20",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-google-mobile-ads": "^17.0.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.2.4",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~57.0.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
